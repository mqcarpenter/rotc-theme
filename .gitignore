# This repo mirrors the site's document root, but only tracks
# wp-content/ (custom themes, plugins, uploads) plus the one custom
# root index.php below. WordPress core (wp-admin, wp-includes, every
# OTHER root wp-*.php file, wp-config.php) is vendor code / secrets --
# trivially reinstalled or never meant to leave the server, not
# something tracked here. /manage/ is its own fully separate git repo
# (mqcarpenter/rotc26) with its own deploy workflow -- ignored here
# (implicitly, by not being wp-content or index.php) so the two never
# collide.
/*
!/.gitignore
!/wp-content
!/index.php

# The backup archives themselves must never be committed -- these are
# multi-hundred-MB tar/zip files, not source content.
wp-content/backuply/
wp-content/backups-dup-lite/

# WordPress core, plugin, and cache-generated data, none of it source.
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/litespeed/

.DS_Store
